// Pipeline order
const STATUS_ORDER = [
  "Requested",
  "Scheduled for Taping",
  "Audio Editing",
  "Video Editing",
  "Review",
  "Done",
];
const PROJECT_STATUSES = [...STATUS_ORDER, "Pending", "Cancelled"];

// Generator
function makeVideo(id, project_id, title, status, editor_id, mins, secs, opts = {}) {
  return {
    id,
    project_id,
    title,
    status,
    main_editor_id: editor_id,
    duration_minutes: mins,
    duration_seconds: secs,
    language: opts.language || "Indonesian",
    has_english_subtitle: opts.en_sub || false,
    has_indonesian_subtitle: opts.id_sub !== false,
    revision_notes: opts.revision_notes || null,
    notes: opts.notes || null,
    position: opts.position || id,
    video_size_mb: mins ? Math.round((mins * 60 + (secs || 0)) * 8) : null,
    profiles: PROFILES.find(p => p.id === editor_id) || null,
    video_link: opts.video_link || null,
  };
}

let _vid = 1;
const v = (pid, title, status, editor, mins, secs, opts) => makeVideo(_vid++, pid, title, status, editor, mins, secs, opts);

